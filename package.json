{
  "name": "@bakung-ui/minimax.css",
  "description": "A reset CSS library with variables",
  "version": "26.1.3",
  "keywords": [
    "css",
    "css-library",
    "reset-css",
    "css-theme"
  ],
  "author": "Tria Warman @triawarman",
  "style": "dist/minimax.min.css",
  "exports": {
    "unpkg": "./dist/minimax.min.css",
    "style": "./dist/minimax.min.css"
  },
  "files": [
    "css",
    "dist",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE.md",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://bakung-ui.github.io/minimax.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bakung-ui/minimax.css.git"
  },
  "bugs": "https://github.com/bakung-ui/minimax.css/issues",
  "devDependencies": {
    "cssnano": "^7.1.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-discard-comments": "^7.0.5",
    "postcss-import": "^16.1.1"
  },
  "scripts": {
    "build:_minimaxMinify": "postcss css/_styles.css > dist/_minimax.min.css --use postcss-import --use cssnano --no-map",
    "build:combine": "postcss css/index.css -o dist/minimax.css --use postcss-import --use cssnano --no-map --env build:combine",
    "build:minify": "postcss dist/minimax.css > dist/minimax.min.css --no-map",
    "build": "npm run build:_minimaxMinify && npm run build:combine && npm run build:minify"
  },
  "engines": {
    "node": ">=v22.16.0",
    "npm": ">=10.9.2"
  },
  "packageManager": "yarn@4.12.0"
}
